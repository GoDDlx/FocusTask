# PostgreSQL connection string used by Drizzle ORM (server-side only).
# Examples:
#   Local:        postgresql://postgres:postgres@127.0.0.1:5432/app_db
#   Neon (pooled): postgresql://USER:PASS@ep-xxx-pooler.region.aws.neon.tech:5432/neondb?sslmode=require
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db
